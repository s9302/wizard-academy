# Copy to .env and fill in. .env is gitignored and must never be committed.

# This machine's Tailscale IPv4 address (run: tailscale ip -4).
# Caddy is published on this address and on 127.0.0.1 only.
TAILNET_IP=100.x.y.z

# Port Caddy listens on, on both of the addresses above.
HTTP_PORT=8080

# Phase 2 will add: GAME_PIN, SESSION_SECRET, COOKIE_SECURE
