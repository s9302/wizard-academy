# Copy to .env and fill in. .env is gitignored and must never be committed.
# chmod 600 .env

# This machine's Tailscale IPv4 address (run: tailscale ip -4).
# The tailnet listener (port 8080) is published on this address only.
TAILNET_IP=100.x.y.z

# Shared access PIN, at least 6 characters. Longer is better: 8+ digits.
# Changing it logs everyone out.
GAME_PIN=

# Signs session cookies. Generate with: openssl rand -hex 32
# Changing it also logs everyone out.
SESSION_SECRET=

# "true" in production (cookie only sent over HTTPS, i.e. via the tunnel).
# "false" to test over plain HTTP at http://game:8080.
COOKIE_SECURE=true
