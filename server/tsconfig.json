{
  // Node 24 runs .ts files directly by stripping the types, so there is no build
  // step. That only works for "erasable" syntax (no enums, no parameter
  // properties), which erasableSyntaxOnly enforces.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "../shared/src"]
}
