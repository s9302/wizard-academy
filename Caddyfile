# Caddy serves the built client and forwards /ws to the game server. Every
# request except the PIN page itself must pass the game server's session check
# first. Plain HTTP only: TLS is handled by Cloudflare at the tunnel edge.
{
	admin off
	auto_https off
	# Don't write config/state to disk; the container filesystem is read-only.
	persist_config off
}

# The site, shared by both listeners. {args[0]} is where the real client IP
# comes from; it is sent to the game server as X-Client-IP (for PIN rate
# limiting), overwriting anything the client sent itself.
(site) {
	encode zstd gzip

	request_body {
		max_size 16KB
	}

	header {
		# 'wasm-unsafe-eval' is needed to start the Rapier physics engine (WebAssembly).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		# not no-referrer: that makes browsers send "Origin: null" on POSTs,
		# which the PIN form's Origin check (rightly) rejects
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# The PIN page's form post and stylesheet: the only things reachable
	# without a session.
	handle /auth/* {
		reverse_proxy server:3000 {
			header_up X-Client-IP {args[0]}
		}
	}

	handle {
		# Ask the game server whether this request has a valid session cookie.
		# If not, its answer (the PIN page, HTTP 401) goes to the browser instead.
		forward_auth server:3000 {
			uri /auth/check
			header_up X-Client-IP {args[0]}
			# For /ws, don't turn the check itself into a WebSocket upgrade.
			header_up -Upgrade
			header_up -Connection
		}

		# The game socket and the account API (login, profile).
		@game path /ws /api/*
		handle @game {
			reverse_proxy server:3000 {
				header_up X-Client-IP {args[0]}
			}
		}

		handle {
			root * /srv
			# Hashed asset filenames never change content, so they can be cached
			# (privately: they're behind the PIN). index.html is revalidated so
			# updates show up on reload.
			@assets path /assets/*
			@audio path /audio/* /textures/*
			@other not path /assets/* /audio/* /textures/*
			header @assets Cache-Control "private, max-age=31536000, immutable"
			# Music, sound effects and the texture atlas: big and rarely changed, so a day.
			header @audio Cache-Control "private, max-age=86400"
			# no-transform: stops Cloudflare injecting its analytics/bot scripts
			header @other Cache-Control "no-cache, no-transform"
			file_server
		}
	}
}

# Tailnet listener (published on the Tailscale IP only). The connecting
# address is the real client; CF-Connecting-IP is ignored here, so nobody on
# the tailnet can fake their address to dodge the PIN limit.
:8080 {
	import site {remote_host}
}

# Tunnel listener (published on 127.0.0.1 only, where cloudflared connects).
# Requests arrive from cloudflared, so the visitor's address is the
# CF-Connecting-IP header Cloudflare adds.
:8081 {
	# Visitors who typed http:// reach Cloudflare unencrypted; send them to
	# https:// before anything (like a PIN) is posted. HSTS then makes the
	# browser go straight to https:// next time. Not includeSubDomains, so
	# other spencersmith.win sites are unaffected.
	@insecure header X-Forwarded-Proto http
	redir @insecure https://{host}{uri} 308
	header Strict-Transport-Security "max-age=31536000"

	import site {http.request.header.CF-Connecting-IP}
}
