# Caddy serves the built client and forwards /ws to the game server.
# Plain HTTP only: TLS is handled by Cloudflare once the tunnel exists (Phase 2).
{
	admin off
	auto_https off
	# Don't write config/state to disk; the container filesystem is read-only.
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		# 'wasm-unsafe-eval' is needed to start the Rapier physics engine (WebAssembly).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /ws {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		# Hashed asset filenames never change content, so they can be cached forever.
		# Everything else (index.html) is revalidated so updates show up on reload.
		@assets path /assets/*
		@other not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @other Cache-Control "no-cache"
		file_server
	}
}
